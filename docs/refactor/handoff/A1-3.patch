+    transform: {kind: refine, native: {rmsd_threshold_angstrom: 0.25}}
+""",
+    "deduplicate": """
+  - id: s_next
+    executor: structure_transform
+    bindings:
+      structure: {source: {step: s_gen, port: structures}}
+    transform: {kind: deduplicate}
+""",
+    "orca": """
+  - id: s_next
+    executor: calculation
+    bindings:
