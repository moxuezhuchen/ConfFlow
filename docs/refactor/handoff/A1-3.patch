+# -- A1-3: `confflow v4 run` ------------------------------------------------------
+
+_CONFGEN_STEP = """
+  - id: s_gen
+    executor: confgen
+    bindings:
+      structure: {source: {run: structures}}
+    confgen:
+      schema_version: 3
+      index_base: 1
+      paths:
