-        xyz_file_path = os.path.splitext(log_file)[0] + ".xyz"
-        if os.path.exists(xyz_file_path):
-            try:
-                with open(xyz_file_path) as f:
-                    coords: list[str] = []
-                    lines = f.readlines()
