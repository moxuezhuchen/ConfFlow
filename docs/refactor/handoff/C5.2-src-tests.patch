-        info = f"Energy={res.get('energy')}"
-
-    cid = orig_meta.get("CID")
-    if cid is not None and str(cid).strip() != "":
-        info += f" CID={cid}"
-
-    # Topology overrides are an explicit contract tied to this frame's atom
