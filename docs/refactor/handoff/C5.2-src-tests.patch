-            "status": "success",
-            key: final_val,
-            "final_coords": final_coords,
-            "num_imag_freqs": res.get("num_imag_freqs"),
-            "lowest_freq": res.get("lowest_freq"),
-            "g_corr": gc,
-            "rescued_by_scan": True,
-            "scan_peak_bond": float(r_best),
-        }
