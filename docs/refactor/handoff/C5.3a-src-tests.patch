+    # Correct heavy-atom distance is 0.1 A, above the 0.05 cutoff.
+    correct = _reference_kabsch_rmsd(candidate["coords"][[1, 2]], reference["coords"][[0, 1]])
+    assert correct == pytest.approx(0.1, abs=1e-9)
