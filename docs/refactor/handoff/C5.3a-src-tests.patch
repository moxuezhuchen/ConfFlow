+def test_compare_frames_threshold_is_strictly_less_than():
+    from confflow.science.frame_compare import compare_frames, kabsch_rmsd
+
+    left = {
+        "original_index": 0,
+        "energy": -2.0,
+        "atoms": ["C", "C", "C"],
+        "coords": _triangle(1.0),
