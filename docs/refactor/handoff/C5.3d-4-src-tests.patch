-            entry = report_map.get(curr)
-        if entry and str(entry.get("Status", "")).startswith("Kept"):
-            counts[curr] += 1
-
-    for position, f in enumerate(final_unique):
-        f["count"] = counts.get(f["original_index"], 1)
-        f["rmsd_to_min"] = 0.0 if position == 0 else None
