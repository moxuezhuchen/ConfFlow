-                search_work=entry.get("Search_Work"),
-            )
-        elif status.startswith("Kept"):
-            record.update(
-                status="kept",
-                reason=str(entry.get("Reason", "")),
-                search_complete=entry.get("Search_Complete"),
-                search_work=entry.get("Search_Work"),
