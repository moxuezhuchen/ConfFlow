-        for i in range(len(ch) - 1):
-            a = int(ch[i])
-            b = int(ch[i + 1])
-            if mol.GetBondBetweenAtoms(a, b) is None:
-                missing.append((a, b))
-    if missing:
-        pairs = ", ".join([f"{a + 1}-{b + 1}" for a, b in missing[:5]])
-        extra = "" if len(missing) <= 5 else f" ... {len(missing)} total"
