-def _new_frame_record(frame: dict) -> dict:
-    extra = frame.get("extra_data", {}) or {}
-    return {
-        "frame_id": frame.get("original_index"),
-        "cid": extra.get("CID"),
-        "topology_group": None,
-        "topology_status": None,
-        "topology_reason": "",
-        "status": "pending",
-        "reason": "",
-        "removed_by": None,
-        "representative_frame_id": None,
-        "witness_rmsd": None,
-        "cutoff": None,
-        "mapping": None,
-        "mapping_permutation": None,
