-    Parameters
-    ----------
-    mol : Any
-        RDKit molecule object.
-    add_bond : list[list[int]] or None
-        Bonds to add (1-based index pairs).
-    del_bond : list[list[int]] or None
-        Bonds to remove (1-based index pairs).
-
