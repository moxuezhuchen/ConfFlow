-class TestR9AReadDoesNotPublish:
-    """R9 item 1: resolving is a read; publishing is a separate, deliberate act.
-
-    The defect this closes: resolving used to adopt whatever it returned.  A
-    background read that had already been superseded by a newer server therefore
-    changed the contract in force on its way out, and the presenter's epoch check
-    -- which only ran *after* the value came back -- could no longer undo it.
-    With A/B reads interleaved, the winner was whoever finished last, not
-    whoever was asked last.
-    """
-
-    def test_resolve_candidate_returns_the_answer_without_adopting_it(self) -> None:
-        before = parse_fixture("producer_v2.json")
-        after = parse_fixture("producer_v2_g16_default.json")
-        provider = _ScriptedProvider([before, after])
-        service = EditorContractService(provider)
-        in_force = service.current()
-
-        candidate = service.resolve_candidate(server_id="gpu-01")
-
-        assert candidate is after
-        assert provider.calls == 2, "the provider really was asked"
-        assert service.current() is in_force, "resolving published the answer"
-
-    def test_publish_is_what_adopts_and_it_reports_the_move(self) -> None:
-        before = parse_fixture("producer_v2.json")
-        after = parse_fixture("producer_v2_g16_default.json")
-        service = EditorContractService(_ScriptedProvider([before, after]))
-        in_force = service.current()
-        candidate = service.resolve_candidate(server_id="gpu-01")
-
-        refresh = service.publish(candidate)
-
-        assert service.current() is candidate
-        assert refresh.previous is in_force
-        assert refresh.current is candidate
