-                ContractDiagnostic(
-                    severity="warning",
-                    code=DiagnosticCode.RECIPE_FIELD_UNKNOWN,
-                    message=(
-                        f"Recipe {recipe.label or recipe.id!r} names field {field_id!r}, "
-                        "which this editor manifest does not describe; the field is "
-                        "ignored until the manifest declares it."
-                    ),
-                    artifact=f"recipe:{recipe.id}",
-                )
-            )
