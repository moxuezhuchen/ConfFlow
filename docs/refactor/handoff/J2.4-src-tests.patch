-        manifest_source = "producer"
-        manifest_version = str(raw_manifest.get("schema") or "")
-
-    # -- recipe catalog -----------------------------------------------------
-    raw_catalog = raw.get("recipe_catalog")
-    if raw_catalog is None:
-        catalog = fallback.catalog
-        catalog_source: ArtifactSource = "stable-fallback"
-        catalog_version = str(catalog.schema)
-        catalog_digest = fallback.catalog_sha256
-        diagnostics.append(
-            ContractDiagnostic(
-                severity="info",
-                code=DiagnosticCode.CATALOG_MISSING,
-                message=(
-                    "The producer publishes no recipe catalog, so the bundled "
-                    "compatibility snapshot supplies the recipes."
-                ),
-                artifact=ARTIFACT_CATALOG,
-            )
-        )
-    else:
-        if not isinstance(raw_catalog, Mapping):
