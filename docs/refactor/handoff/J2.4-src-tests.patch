-"""The application's single source of the current contract.
-
-Pages do not resolve contracts, do not cache them, and do not decide when to
-re-read one.  They ask for :meth:`EditorContractService.current` and get a
-:class:`VerifiedEditorContract`.  That is deliberate: contract lifetime is
-infrastructure, and a page that owned it would have to make policy decisions
-(cache, retry, fall back?) that it has no business making.
-
-The one genuinely subtle behaviour lives here, and it is a *non*-behaviour:
-
-    A refresh never rewrites an open draft.
-
-If the producer contract changes while a draft is open -- a new field manifest,
-a different recipe catalog, a field that no longer exists -- the contract is
-replaced and the draft keeps the bytes it had.  The user's work is not the
-producer's to delete, and a GUI that "helpfully" migrated a payload would
-silently destroy unknown members and explicitly-set values that the new manifest
-happens not to describe.  What the application does instead is *notice*: the
-draft still carries the ``contract_key`` it was edited under, so a caller can
-compare it with :meth:`EditorContractService.current` and report the difference.
-Reconciling is a decision for the user, or for a future explicit migration
-command -- never a background side effect.
-"""
-
-from __future__ import annotations
-
-from dataclasses import dataclass
-
-from .models import (
-    ContractDiagnostic,
-    ContractTarget,
-    DiagnosticCode,
-    VerifiedEditorContract,
-)
-from .providers import ProducerContractProvider, StableFallbackContractProvider
-
-
-@dataclass(frozen=True, slots=True)
-class ContractRefresh:
-    """The outcome of asking the provider again.
-
-    A value, not an event: the caller decides what to do with it, and nothing has
-    already happened by the time it is returned.
-    """
-
-    previous: VerifiedEditorContract | None
-    current: VerifiedEditorContract
-
-    @property
-    def changed(self) -> bool:
-        """True when the resolved contract is not the one that was in force.
-
-        Compares ``contract_key``, which is derived from the verified digests, so
-        this is a comparison of *content* and not of object identity.
-        """
-        if self.previous is None:
-            return True
-        return self.previous.contract_key != self.current.contract_key
-
-    @property
-    def diagnostics(self) -> tuple[ContractDiagnostic, ...]:
-        """Findings about the refresh itself, on top of the contract's own."""
-        if not self.changed or self.previous is None:
-            return ()
-        return (
-            ContractDiagnostic(
-                severity="warning",
-                code=DiagnosticCode.CONTRACT_CHANGED,
-                message=(
-                    f"The producer contract changed ({self.previous.contract_key} -> "
-                    f"{self.current.contract_key}). Open documents keep the content they "
-                    "were created with; review them before running."
-                ),
-                artifact="contract",
-            ),
-        )
-
-
-class EditorContractService:
-    """Holds the provider and the contract currently in force."""
-
-    def __init__(
-        self,
-        provider: ProducerContractProvider | None = None,
-        *,
-        target: ContractTarget | None = None,
-    ) -> None:
-        self._provider = provider if provider is not None else StableFallbackContractProvider()
-        self._target = target
-        self._current: VerifiedEditorContract | None = None
-
-    @property
-    def provider(self) -> ProducerContractProvider:
-        return self._provider
-
-    @property
-    def target(self) -> ContractTarget | None:
-        return self._target
-
-    def resolve_candidate(self, *, server_id: str | None = None) -> VerifiedEditorContract:
-        """Ask the provider without touching the contract currently in force.
-
-        This is the R9 fix and it is a *read*, not a write: the caller gets an
-        immutable candidate and decides whether to publish it.  A caller whose
-        read has already been superseded -- the user picked a second server while
-        the first read was in flight, the page was torn down, the request failed
-        after a newer one succeeded -- simply drops the value, and nothing in the
-        process has changed.  A service method that published on its own
-        initiative could not offer that guarantee.
-
-        ``server_id=None`` resolves against the service's own target (a local or
-        fallback provider ignores it); a ``server_id`` resolves that server, which
-        is what a compute-target switch needs.
-        """
-        target = self._target if server_id is None else ContractTarget.remote(server_id)
-        return self._provider.resolve(target)
-
-    def publish(self, candidate: VerifiedEditorContract) -> ContractRefresh:
-        """Adopt ``candidate`` as the contract in force and report the move.
-
-        The write half of :meth:`resolve_candidate`, split out so the caller can
-        pair it with an epoch check: resolve off-thread, then publish on the UI
-        thread only if the epoch still matches.
-
-        Publishing never rewrites a draft: the draft keeps the bytes and the
-        ``contract_key`` it was edited under, and the returned
-        :class:`ContractRefresh` is how a caller notices that contract in force
-        and draft now disagree.
-        """
-        previous = self._current
-        self._current = candidate
-        return ContractRefresh(previous=previous, current=self._current)
-
-    def current(self) -> VerifiedEditorContract:
-        """The contract in force, resolved once and then cached.
-
-        Cached because every page construction would otherwise re-read and re-verify
-        the same bytes, and because two pages asking at different moments must see
-        the *same* contract -- a page whose field set disagreed with another page's
-        would be a genuinely confusing bug.
-        """
-        if self._current is None:
-            self._current = self._provider.resolve(self._target)
-        return self._current
-
-
-__all__ = ["ContractRefresh", "EditorContractService"]
