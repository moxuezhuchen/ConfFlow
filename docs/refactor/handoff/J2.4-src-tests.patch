-    workflow_schema_sha256 = _verify_digest(
-        workflow_schema,
-        raw.get("workflow_schema_sha256"),
-        artifact=ARTIFACT_WORKFLOW_SCHEMA,
-    )
-
-    # -- editor manifest ----------------------------------------------------
-    raw_manifest = raw.get("editor_manifest")
-    if raw_manifest is None:
-        manifest = fallback.manifest
-        manifest_source: ArtifactSource = "stable-fallback"
