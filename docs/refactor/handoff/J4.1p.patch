+@requires_producer
+@pytest.mark.gui
+def test_a_legacy_native_member_survives_editing_other_confgen_fields(
+    qtbot: Any, tmp_path: Any
+) -> None:
+    """The GUI never drops ``confgen.native`` it cannot edit; the producer reports it."""
+    contract = _live_contract()
+    page, _service, store = _live_page(qtbot, contract, tmp_path)
+    draft = author_v4_draft(contract, "confgen_torsion")
+    payload = draft.document.to_mapping()
+    legacy = {"chains": ["1-2-3-4"], "angle_step": 120}
+    payload["steps"][0]["confgen"]["native"] = dict(legacy)
+    store.reset(replace(draft, document=draft.document.with_payload(payload)))
+    page._refresh()
+    form = page._calc_section.confgen_form
+    assert form is not None
+    form._add_path({"start": 2, "end": 3, "move": "end", "angles": [0, 120]})
+    confgen = store.current.document.to_mapping()["steps"][0]["confgen"]
+    assert confgen["native"] == legacy
+    assert confgen["paths"][0]["move"] == "end"
+
+
